---
// A generated topic or tag page in one language. The route files in src/pages/ only list which pages exist.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TaxonomyPage from './TaxonomyPage.astro';
import { siteConfig, type SiteLocale } from '../config/site';
import { tags, topics, type TagKey, type TopicKey } from '../config/taxonomy';
import { getPosts } from '../lib/posts';

type Props = { locale: SiteLocale } & ({ kind: 'topic'; topic: TopicKey } | { kind: 'tag'; tag: TagKey });

const props = Astro.props;
const copy = siteConfig.localized[props.locale].home;
const title = props.kind === 'topic' ? copy.topicTitle(topics[props.topic].name[props.locale]) : copy.tagTitle(tags[props.tag][props.locale]);
const description = props.kind === 'topic' ? topics[props.topic].summary[props.locale] : copy.tagDescription(tags[props.tag][props.locale]);
// An empty topic stays out of search results until its first post (and out of the sitemap, see astro.config.mjs).
const isEmpty = props.kind === 'topic' && !(await getPosts(props.locale)).some((post) => post.topic === props.topic);
const head = isEmpty ? [{ tag: 'meta' as const, attrs: { name: 'robots', content: 'noindex, follow' } }] : [];
---

<StarlightPage frontmatter={{ title, description, template: 'splash', pageType: 'landing', head }}>
  {props.kind === 'topic' ? <TaxonomyPage kind="topic" topic={props.topic} /> : <TaxonomyPage kind="tag" tag={props.tag} />}
</StarlightPage>
