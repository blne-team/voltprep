---
import { getLocalizedSiteConfig, siteConfig } from '../config/site';

const { siteTitleHref } = Astro.locals.starlightRoute;
const content = getLocalizedSiteConfig(Astro.url.pathname);
---

<a href={siteTitleHref} class="site-title" aria-label={`${siteConfig.brand.name} ${content.homeLabel}`}>
  <span class="brand-mark" aria-hidden="true"><span></span></span>
  <span class="wordmark">
    <span class="full-name" translate="no">{siteConfig.brand.name}</span>
    <span class="short-name" translate="no">{siteConfig.brand.shortName}</span>
    <span class="descriptor">{content.descriptor}</span>
  </span>
</a>

<style>
  .site-title {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.72rem;
    padding: 0.28rem 0.72rem 0.28rem 0.3rem;
    border: 1px solid transparent;
    border-radius: 0.68rem;
    color: var(--sl-color-text);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
  }

  .site-title:hover {
    border-color: var(--sl-color-hairline);
    background: color-mix(in srgb, var(--sl-color-bg-nav) 82%, var(--ff-visual));
  }

  .site-title:active { transform: translateY(1px); }

  .brand-mark {
    position: relative;
    display: grid;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 70%, var(--sl-color-hairline));
    border-radius: 0.48rem;
    background: var(--sl-color-accent-low);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sl-color-bg-nav) 65%, transparent);
  }

  .brand-mark::before,
  .brand-mark::after,
  .brand-mark span {
    position: absolute;
    border-radius: 999px;
    background: var(--sl-color-accent);
    content: '';
  }

  .brand-mark::before {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--ff-lime);
  }

  .brand-mark::after {
    width: 1.32rem;
    height: 1px;
    transform: rotate(-33deg);
  }

  .brand-mark span {
    width: 1px;
    height: 1.32rem;
    transform: rotate(-33deg);
  }

  .wordmark {
    display: grid;
    gap: 0.16rem;
    min-width: 0;
  }

  .full-name,
  .short-name {
    font-family: var(--sl-font-heading);
    font-size: 1.08rem;
    font-weight: 680;
    font-variation-settings: 'wdth' 96;
    letter-spacing: -0.035em;
  }

  .descriptor {
    color: var(--sl-color-gray-3);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .short-name { display: none; }

  @media (max-width: 31rem) {
    .full-name { display: none; }
    .short-name { display: inline; }
    .descriptor { display: none; }
    .site-title { padding-right: 0.3rem; }
    .wordmark { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-title { transition: none; }
  }
</style>
