---
import { SITE_URL } from 'astro:env/server';
import { adPlacements, adsenseClientId, type AdPlacement } from '../config/ads';

interface Props {
  placement: AdPlacement;
}

const { placement } = Astro.props;
const config = adPlacements[placement];
const showLiveAd = import.meta.env.PROD && Boolean(SITE_URL && adsenseClientId && config.slot);
const showPreview = import.meta.env.DEV;
const shouldRender = showLiveAd || showPreview;
---

{shouldRender && (
  <aside
    class:list={['ad-placement', `ad-placement--${placement}`]}
    aria-label="Advertisement"
    data-pagefind-ignore
  >
    <span class="ad-label">Advertisement</span>
    <div class="ad-frame">
      {showLiveAd ? (
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={adsenseClientId}
          data-ad-slot={config.slot}
          data-ad-format={config.format}
          data-full-width-responsive="true"
        ></ins>
      ) : (
        <div class="ad-preview" aria-hidden="true">
          <span>{placement} ad preview</span>
          <small>Responsive Google AdSense unit</small>
        </div>
      )}
    </div>
    {showLiveAd && <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>}
  </aside>
)}

<style>
  .ad-placement {
    clear: both;
    width: 100%;
    max-width: var(--sl-content-width);
    margin: 3rem auto;
    color: var(--sl-color-gray-2);
    text-align: center;
  }

  .ad-placement--home {
    width: min(1180px, calc(100% - 40px));
    max-width: none;
    margin-block: 1rem 5rem;
  }

  .ad-label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .ad-frame {
    display: grid;
    min-height: 110px;
    place-items: center;
    overflow: hidden;
    border-block: 1px solid var(--sl-color-hairline);
  }

  .ad-placement--content .ad-frame {
    min-height: 180px;
  }

  .adsbygoogle {
    width: 100%;
  }

  .ad-preview {
    display: grid;
    width: 100%;
    min-height: inherit;
    place-content: center;
    gap: 0.35rem;
    background:
      linear-gradient(135deg, transparent 0 49.5%, var(--sl-color-hairline) 49.5% 50.5%, transparent 50.5%),
      var(--sl-color-bg-nav);
    background-size: 24px 24px;
  }

  .ad-preview span,
  .ad-preview small {
    width: fit-content;
    margin-inline: auto;
    padding-inline: 0.35rem;
    background: var(--sl-color-bg-nav);
  }

  .ad-preview span {
    color: var(--sl-color-text);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: capitalize;
  }

  .ad-preview small {
    font-size: 0.7rem;
  }

  @media (max-width: 720px) {
    .ad-placement--home {
      width: min(100% - 28px, 1180px);
    }
  }

  @media print {
    .ad-placement {
      display: none;
    }
  }
</style>
