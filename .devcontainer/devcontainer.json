{
  "name": "Faraday Fieldbook",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "initializeCommand": "sh -c 'printf \"USER_UID=%s\\nUSER_GID=%s\\n\" \"$(id -u)\" \"$(id -g)\" > .devcontainer/.env'",
  "workspaceFolder": "/workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint",
        "astro-build.astro-vscode"
      ]
    }
  },
  "updateRemoteUserUID": false,
  "remoteUser": "user",
  "forwardPorts": [
    4321,
    8787
  ]
}
