# Set before production builds; canonical URLs and sitemap use this origin.
SITE_URL=https://your-domain.ca

# Optional Google AdSense configuration. Use the IDs copied from your AdSense account.
# Live ad code is included only in production builds. Local development shows placeholders.
PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
PUBLIC_GOOGLE_ADSENSE_HOME_SLOT=0000000000
PUBLIC_GOOGLE_ADSENSE_CONTENT_SLOT=0000000000
PUBLIC_GOOGLE_ADSENSE_FOOTER_SLOT=0000000000

# Optional giscus comments. Enable GitHub Discussions, install the giscus app,
# then paste the values generated at https://giscus.app/.
# GISCUS_REPO=your-github-owner/your-public-repository
# GISCUS_REPO_ID=R_your_repository_id
# GISCUS_CATEGORY=Study discussions
# GISCUS_CATEGORY_ID=DIC_your_category_id
